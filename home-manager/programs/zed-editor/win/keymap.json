      "ctrl-shift-pageup": "pane::SwapItemLeft",
      "ctrl-shift-pagedown": "pane::SwapItemRight",
      "alt-k w": ["pane::CloseAllItems", { "close_pinned": false }],
      "alt-k u": ["pane::CloseCleanItems", { "close_pinned": false }],
      "alt-k e": ["pane::CloseItemsToTheLeft", { "close_pinned": false }],
      "alt-k t": ["pane::CloseItemsToTheRight", { "close_pinned": false }],
