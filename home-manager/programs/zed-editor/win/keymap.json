// Windows keymap based on the live macOS setup. Standard app commands use Ctrl;
// Emacs Meta commands use the physical Alt key. Pane focus uses Ctrl+Alt+HJKL.
[
  {
    "unbind": {
      "f4": "debugger::Start",
      "ctrl-alt-i": "dev::ToggleInspector",
      "ctrl-alt-shift-p": "dev::ToggleFpsOverlay",
      "ctrl-alt-shift-o": "dev::ResetFrameOverlayStats",
      "ctrl-alt-l": "lsp_tool::ToggleMenu",
      "ctrl-c": "menu::Cancel",
      "ctrl-escape": "menu::Cancel",
      "ctrl-shift-w": "workspace::CloseWindow",
      "shift-escape": "workspace::ToggleZoom",
      "ctrl-shift-c": "collab_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-s": "buffer_search::Deploy",
      "ctrl-r": "buffer_search::Deploy",
      "ctrl-k": "editor::KillRingCut",
      "ctrl-y": "editor::KillRingYank",
      "ctrl-n": "editor::MoveDown",
      "ctrl-b": "editor::MoveLeft",
      "ctrl-f": "editor::MoveRight",
      "ctrl-a": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": false },
      ],
      "ctrl-e": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-p": "editor::MoveUp",
      "ctrl-d": "editor::Delete",
      "ctrl-v": "editor::MovePageDown",
      "ctrl-w": "editor::Cut",
      "ctrl-j": "editor::JoinLines",
    },
  },
  {
    "context": "Editor && selection_mode",
    "unbind": {
      "ctrl-g": "editor::Cancel",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "g j": "vim::Down",
      "k": ["vim::Up", { "display_lines": true }],
      "g k": "vim::Up",
    },
  },
  {
    "context": "vim_mode == normal",
    "unbind": {
      "ctrl-x": "vim::Decrement",
    },
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "ctrl-x": "vim::Decrement",
      "g ctrl-x": ["vim::Decrement", { "step": true }],
    },
  },
  {
    "context": "vim_mode == helix_select",
    "unbind": {
      "ctrl-x": "vim::Decrement",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "unbind": {
      "ctrl-x": "vim::Decrement",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-m": "editor::Newline",
      "ctrl-a": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": false, "stop_at_indent": true },
      ],
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-i": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Editor && showing_completions",
    "unbind": {
      "enter": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Editor && (vim_mode == insert || !vim_mode)",
    "bindings": {
      "ctrl-k": "editor::KillRingCut",
      "ctrl-y": "editor::KillRingYank",
      "ctrl-n": "editor::MoveDown",
      "ctrl-b": "editor::MoveLeft",
      "ctrl-f": "editor::MoveRight",
      "ctrl-e": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-p": "editor::MoveUp",
      "ctrl-d": "editor::Delete",
      "ctrl-v": "editor::Paste",
      "ctrl-c": "editor::Copy",
      "ctrl-x": "editor::Cut",
      "ctrl-w": "editor::Cut",
      "ctrl-z": "editor::Undo",
      "ctrl-shift-z": "editor::Redo",
      "ctrl-_": "editor::Undo",
      "alt-f": "editor::MoveToNextWordEnd",
      "alt-b": "editor::MoveToPreviousWordStart",
      "alt-right": "editor::MoveToNextWordEnd",
      "alt-left": "editor::MoveToPreviousWordStart",
      "alt-m": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": false, "stop_at_indent": true },
      ],
      "alt-<": "editor::MoveToBeginning",
      "alt->": "editor::MoveToEnd",
      "alt-d": [
        "editor::DeleteToNextWordEnd",
        { "ignore_newlines": false, "ignore_brackets": false },
      ],
      "alt-backspace": "editor::DeleteToPreviousWordStart",
      "alt-delete": "editor::DeleteToPreviousWordStart",
      "alt-w": "editor::Copy",
      "home": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": false },
      ],
      "end": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-home": "editor::MoveToBeginning",
      "ctrl-end": "editor::MoveToEnd",
      "ctrl-shift-left": "editor::SelectLeft",
      "ctrl-shift-right": "editor::SelectRight",
      "alt-shift-left": "editor::SelectToPreviousWordStart",
      "alt-shift-right": "editor::SelectToNextWordEnd",
      "ctrl-alt-left": "editor::MoveToPreviousSubwordStart",
      "ctrl-alt-right": "editor::MoveToNextSubwordEnd",
      "ctrl-alt-shift-left": "editor::SelectToPreviousSubwordStart",
      "ctrl-alt-shift-right": "editor::SelectToNextSubwordEnd",
      "ctrl-alt-backspace": "editor::DeleteToPreviousSubwordStart",
      "ctrl-alt-delete": "editor::DeleteToNextSubwordEnd",
      "ctrl-shift-i": "editor::Format",
      "ctrl-l": "editor::SelectLine",
    },
  },
  {
    "context": "Editor && !vim_mode",
    "bindings": {
      "ctrl-a": "editor::SelectAll",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-alt-shift-backspace": "editor::GoToNextChange",
      "ctrl-shift-backspace": "editor::GoToPreviousChange",
      "ctrl-shift-enter": "editor::NewlineAbove",
      "ctrl-enter": "editor::NewlineBelow",
      "alt-enter": "editor::OpenSelectionsInMultibuffer",
      "ctrl-alt-e": "editor::SelectEnclosingSymbol",
      "alt-k z": "editor::ToggleSoftWrap",
      "alt-k alt-/": "editor::ToggleBlockComments",
      "ctrl-/": [
        "editor::ToggleComments",
        { "advance_downwards": false, "comment_empty_lines": true },
      ],
      "ctrl-.": "editor::ToggleCodeActions",
      "ctrl-alt-d": ["editor::SelectNext", { "replace_newest": false }],
      "alt-k alt-d": ["editor::SelectNext", { "replace_newest": true }],
      "ctrl-shift-l": "editor::SelectAllMatches",
      "alt-k alt-l": "editor::ToggleFold",
      "alt-k alt-j": "editor::UnfoldAll",
      "alt-k alt-0": "editor::FoldAll",
      "alt-k alt-1": "editor::FoldAtLevel_1",
      "alt-k alt-2": "editor::FoldAtLevel_2",
      "alt-k alt-3": "editor::FoldAtLevel_3",
      "alt-k alt-4": "editor::FoldAtLevel_4",
      "alt-k alt-5": "editor::FoldAtLevel_5",
      "alt-k alt-6": "editor::FoldAtLevel_6",
      "alt-k alt-7": "editor::FoldAtLevel_7",
      "alt-k alt-8": "editor::FoldAtLevel_8",
      "alt-k alt-9": "editor::FoldAtLevel_9",
      "alt-k alt-[": "editor::Fold",
      "alt-k alt-]": "editor::UnfoldRecursive",
      "alt-shift-a": "editor::ToggleBlockComments",
      "ctrl-;": [
        "editor::ToggleComments",
        { "advance_downwards": false, "comment_empty_lines": false },
      ],
      "alt-k alt-h": "call_hierarchy::ShowIncomingCalls",
      "alt-k alt-b": "editor::BlameHover",
      "alt-k alt-i": "editor::Hover",
      "alt-k alt-r": "editor::RevealInFileManager",
      "alt-k p": "workspace::CopyPath",
      "ctrl-shift-k": "editor::DeleteLine",
      "ctrl-[": "editor::Outdent",
      "ctrl-]": "editor::Indent",
      "alt-shift-o": "editor::OrganizeImports",
    },
  },
  {
    "context": "Editor && selection_mode",
    "unbind": {
      "down": "editor::SelectDown",
      "ctrl-n": "editor::SelectDown",
      "left": "editor::SelectLeft",
      "ctrl-b": "editor::SelectLeft",
      "pagedown": "editor::SelectPageDown",
      "ctrl-v": "editor::SelectPageDown",
      "pageup": "editor::SelectPageUp",
      "alt-v": "editor::SelectPageUp",
      "right": "editor::SelectRight",
      "ctrl-f": "editor::SelectRight",
      "ctrl-home": "editor::SelectToBeginning",
      "ctrl-end": "editor::SelectToEnd",
      "home": [
        "editor::SelectToBeginningOfLine",
        { "stop_at_soft_wraps": false },
      ],
      "end": ["editor::SelectToEndOfLine", { "stop_at_soft_wraps": false }],
      "alt-right": "editor::SelectToNextWordEnd",
      "alt-left": "editor::SelectToPreviousWordStart",
      "up": "editor::SelectUp",
      "ctrl-p": "editor::SelectUp",
    },
  },
  {
    "context": "Editor && mode == full && edit_prediction",
    "unbind": {
      "ctrl-tab": "editor::NextEditPrediction",
      "ctrl-shift-tab": "editor::PreviousEditPrediction",
    },
  },
  {
    "context": "Editor && !edit_prediction",
    "unbind": {
      "ctrl-tab": "editor::ShowEditPrediction",
    },
  },
  {
    "context": "Editor && showing_signature_help && !showing_completions",
    "unbind": {
      "down": "editor::SignatureHelpNext",
      "up": "editor::SignatureHelpPrevious",
    },
  },
  {
    "context": "Editor && showing_completions",
    "unbind": {
      "tab": "editor::ComposeCompletion",
    },
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "unbind": {
      "pageup": "editor::ContextMenuFirst",
      "pagedown": "editor::ContextMenuLast",
    },
  },
  {
    "context": "Editor && in_snippet && has_previous_tabstop && !showing_completions",
    "unbind": {
      "shift-tab": "editor::PreviousSnippetTabstop",
    },
  },
  {
    "context": "Editor && multibuffer",
    "unbind": {
      "ctrl-up": "editor::MoveToStartOfExcerpt",
      "ctrl-down": "editor::MoveToStartOfNextExcerpt",
      "ctrl-shift-up": "editor::SelectToStartOfExcerpt",
      "ctrl-shift-down": "editor::SelectToStartOfNextExcerpt",
    },
  },
  {
    "context": "CommandPalette || CommandPalette > Picker > Editor",
    "bindings": {
      "escape": "menu::Cancel",
      "ctrl-g": "menu::Cancel",
      "ctrl-v": [
        "workspace::SendKeystrokes",
        "down down down down down down down down down down",
      ],
      "alt-v": ["workspace::SendKeystrokes", "up up up up up up up up up up"],
    },
  },
  {
    "context": "CommandPalette || CommandPalette > Picker > Editor",
    "unbind": {
      "shift-backspace": "command_palette::RemoveSelected",
    },
  },
  {
    "context": "BufferSearchBar > Editor",
    "unbind": {
      "ctrl-s": "search::SelectNextMatch",
      "ctrl-r": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "escape": "buffer_search::Dismiss",
      "tab": "buffer_search::FocusEditor",
      "ctrl-shift-enter": "editor::ToggleFoldAll",
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-shift-p": "file_finder::SelectPrevious",
      "ctrl-j": "pane::SplitDown",
      "ctrl-h": "pane::SplitLeft",
      "ctrl-l": "pane::SplitRight",
      "ctrl-k": "pane::SplitUp",
    },
  },
  {
    "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
    "unbind": {
      "ctrl-j": "pane::SplitDown",
      "ctrl-h": "pane::SplitLeft",
      "ctrl-l": "pane::SplitRight",
      "ctrl-k": "pane::SplitUp",
    },
  },
  {
    "context": "Picker > Editor",
    "unbind": {
      "ctrl-shift-a": "picker::ToggleActionsMenu",
      "ctrl-shift-s": "picker::ToggleMultiSelect",
    },
  },
  {
    "context": "Picker && with_preview > Editor",
    "unbind": {
      "ctrl-alt-p": "picker::TogglePreview",
    },
  },
  {
    "context": "ProjectSearchBar",
    "unbind": {
      "ctrl-shift-enter": "project_search::ToggleAllSearchResults",
      "ctrl-shift-j": "project_search::ToggleFilters",
      "escape": "project_search::ToggleFocus",
    },
  },
  {
    "context": "ProjectSearchView",
    "unbind": {
      "ctrl-shift-enter": "project_search::ToggleAllSearchResults",
      "ctrl-shift-j": "project_search::ToggleFilters",
      "escape": "project_search::ToggleFocus",
    },
  },
  {
    "context": "Diagnostics",
    "unbind": {
      "ctrl-r": "diagnostics::ToggleDiagnosticsRefresh",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-b": ["terminal::SendText", "\u001bb"],
      "alt-f": ["terminal::SendText", "\u001bf"],
      "alt-left": ["terminal::SendText", "\u001bb"],
      "alt-right": ["terminal::SendText", "\u001bf"],
      "ctrl-shift-v": "terminal::Paste",
      "ctrl-alt-v": "terminal::PasteText",
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-delete": ["terminal::SendText", "\u001b[3;5~"],
      "ctrl-home": ["terminal::SendKeystroke", "ctrl-a"],
      "ctrl-end": ["terminal::SendKeystroke", "ctrl-e"],
      "alt-delete": ["terminal::SendText", "\u001bd"],
      "alt-backspace": ["terminal::SendKeystroke", "ctrl-u"],
      "ctrl-shift-k": "terminal::Clear",
      "ctrl-alt-r": "terminal::RerunTask",
      "shift-down": "terminal::ScrollLineDown",
      "shift-up": "terminal::ScrollLineUp",
      "shift-pagedown": "terminal::ScrollPageDown",
      "shift-pageup": "terminal::ScrollPageUp",
      "shift-end": "terminal::ScrollToBottom",
      "shift-home": "terminal::ScrollToTop",
      "pageup": ["terminal::SendKeystroke", "pageup"],
      "pagedown": ["terminal::SendKeystroke", "pagedown"],
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-v": "terminal::Paste",
      "ctrl-alt-down": "pane::SplitDown",
      "ctrl-alt-left": "pane::SplitLeft",
      "ctrl-alt-right": "pane::SplitRight",
      "ctrl-alt-up": "pane::SplitUp",
      "ctrl-d": "pane::SplitRight",
    },
  },
  {
    "context": "Terminal && selection",
    "unbind": {
      "ctrl-c": "terminal::Copy",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-w": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-f4": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-tab": "pane::ActivateNextItem",
